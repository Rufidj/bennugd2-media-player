+/* ------------------------------------------------------------------------------------------------ http (through FFmpeg, so https works) */
+typedef struct { double deadline; } HttpDl;
+static int http_irq( void * o ) {
+    struct timespec t; clock_gettime( CLOCK_MONOTONIC, &t );
+    return ( ( HttpDl * ) o )->deadline < t.tv_sec + t.tv_nsec / 1e9;
