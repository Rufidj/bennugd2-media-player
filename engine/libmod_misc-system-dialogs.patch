@@ -0,0 +1,24 @@
+/*
+ *  m_progress.h - system progress bar (PS5 message dialog in progress mode)
+ *
+ *  SYSTEM_PROGRESS_OPEN( caption, flags ) -> 0 if it opened, < 0 if not available / failed (flags: 1 = with a cancel button)
+ *  SYSTEM_PROGRESS_SET( percent )  -> moves the bar (0..100)
+ *  SYSTEM_PROGRESS_MESSAGE( text ) -> changes the caption
+ *  SYSTEM_PROGRESS_UPDATE()        -> advances the dialog; call once per frame while it is open (0 = not open, 3 = it was closed: the user
+ *                                     pressed cancel)
+ *  SYSTEM_PROGRESS_CLOSE()         -> closes it
+ *
+ *  Only the PS5 build has one; elsewhere OPEN returns < 0 (or, with MP_FAKE_PROGRESS set, writes what it would do to stderr).
+ */
+#ifndef __M_PROGRESS_H
+#define __M_PROGRESS_H
+
+#include "bgddl.h"
+
+extern int64_t libmod_misc_progress_open( INSTANCE * my, int64_t * params );
+extern int64_t libmod_misc_progress_set( INSTANCE * my, int64_t * params );
+extern int64_t libmod_misc_progress_message( INSTANCE * my, int64_t * params );
+extern int64_t libmod_misc_progress_update( INSTANCE * my, int64_t * params );
+extern int64_t libmod_misc_progress_close( INSTANCE * my, int64_t * params );
+
+#endif
diff --git a/ps5/tools/build-commondialog-stub.sh b/ps5/tools/build-commondialog-stub.sh
new file mode 100755
index 00000000..de248f78
--- /dev/null
+++ b/ps5/tools/build-commondialog-stub.sh
@@ -0,0 +1,12 @@
+#!/bin/sh
+# Builds libSceCommonDialog.so (a link stub, soname libSceCommonDialog.sprx) and installs it in the payload SDK's
+# target/lib, where native-app-boilerplate's `make app` picks every *.so up as an import library.
+# (libSceImeDialog / libSceUserService / libSceSysmodule stubs already ship with the SDK.)
+#   ps5/tools/build-commondialog-stub.sh /path/to/native-app-boilerplate
+set -e
+BP="${1:?path to native-app-boilerplate}"; SDK="$BP/.deps/native/ps5-payload-sdk"
+HERE="$(cd "$(dirname "$0")" && pwd)"; OUT="$(mktemp -d)"
+PS5_PAYLOAD_SDK="$SDK" PS5_CLANG="${PS5_CLANG:-/usr/bin/clang-18}" USE_CCACHE=0 \
+  sh "$BP/tooling/prospero-clang18" -std=c11 -O2 -fPIC -c "$HERE/commondialog_link_stub.c" -o "$OUT/stub.o"
+"$SDK/bin/prospero-lld" --shared -soname libSceCommonDialog.sprx -o "$SDK/target/lib/libSceCommonDialog.so" "$OUT/stub.o"
+rm -rf "$OUT"; echo "installed $SDK/target/lib/libSceCommonDialog.so"
