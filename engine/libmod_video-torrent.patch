+/* ------------------------------------------------------------------------------------------------ pieces */
+static int has_piece( const Peer * p, int i ) { return ( size_t ) ( i >> 3 ) < p->bits_len && ( p->bits[i >> 3] & ( 0x80 >> ( i & 7 ) ) ); }
