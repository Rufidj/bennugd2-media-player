+    header = 0;
+    g_dl_percent = 100;
+    ret = 0;
+end:
+    if ( g_dl_cancel && ret != 0 ) { ret = -2; snprintf( g_dl_err, sizeof g_dl_err, "cancelled" ); }
+    if ( header && oc ) av_write_trailer( oc );
