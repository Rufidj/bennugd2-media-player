+/* ------------------------------------------------------------------------------------------------ extra public trackers */
+static const char * g_extra_trk[] = {
+    "udp://tracker.opentrackr.org:1337/announce", "udp://explodie.org:6969/announce", "udp://tracker.leechers-paradise.org:6969/announce",
